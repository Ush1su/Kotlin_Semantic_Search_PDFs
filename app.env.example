# Copy to app.env and adjust. app.env is gitignored; this template is not.
#
#   cp app.env.example app.env
#
# The file is used twice, which is why some values look duplicated:
#   1. Docker Compose reads it with --env-file for ${...} substitution in
#      compose.yml (DB_NAME, DB_USERNAME, DB_PASSWORD, EMBEDDING_MODEL).
#   2. The application imports it as a property source
#      (spring.config.import in application.yml) for everything else.
#
# When running under Compose, the app service overrides the four host-dependent
# values below with in-network names, so the values here are what a locally run
# `./gradlew bootRun` uses:
#   DB_URL -> postgres, QDRANT_HOST -> qdrant,
#   EMBEDDING_BASE_URL -> http://ollama:11434, STORAGE_LOCAL_ROOT -> /app/data/uploads


# === Required — no defaults, the app will not start without these ============

DB_URL=jdbc:postgresql://localhost:5432/vector_search
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Used by Compose to create the database and to build the container's DB_URL.
# Must match the database name in DB_URL above.
DB_NAME=vector_search

# Compose passes this to the model-setup service, which pulls it into Ollama.
EMBEDDING_MODEL=qwen3-embedding:0.6b


# === Storage =================================================================

# Where uploaded PDFs are written. Gitignored; Compose mounts ./data/uploads.
STORAGE_LOCAL_ROOT=./data/uploads


# === Embeddings ==============================================================

EMBEDDING_BASE_URL=http://localhost:11434

# Output dimensions of the embedding model. Also sets the Qdrant collection's
# vector size, so changing it after documents exist orphans the collection —
# drop the Qdrant volume and re-upload if you change models.
EMBEDDING_DIMENSIONS=512

# Concurrent embedding batches. Raising it past what your Ollama host can serve
# causes timeouts rather than throughput.
EMBEDDING_MAX_CONCURRENT_BATCHES=1
EMBEDDING_CONNECT_TIMEOUT=10s
EMBEDDING_READ_TIMEOUT=2m


# === Qdrant ==================================================================

QDRANT_HOST=localhost
# gRPC port. The HTTP dashboard is on 6333 and is not used by the app.
QDRANT_PORT=6334
QDRANT_USE_TLS=false
QDRANT_COLLECTION_NAME=chunks

# Named vectors for the hybrid dense + BM25 search. Renaming these after
# ingesting requires recreating the collection.
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25

# How many candidates each arm of the hybrid search fetches before fusion:
# limit * multiplier, capped by the max.
QDRANT_HYBRID_PREFETCH_MULTIPLIER=4
QDRANT_HYBRID_MAX_PREFETCH_LIMIT=100
QDRANT_BM25_TOKEN_MIN_LENGTH=2
QDRANT_MAX_CONCURRENT_UPSERT_BATCHES=2


# === Server ==================================================================

SERVER_PORT=8080

# Largest PDF accepted by POST /api/documents. Spring's own default is 1MB,
# which rejects most real documents.
MAX_UPLOAD_SIZE=50MB

# Every request is attributed to this user until real authentication exists.
DEV_USER_ID=00000000-0000-0000-0000-000000000001


# === Persistence =============================================================

# `update` lets Hibernate manage the schema, which suits a project with no
# migration tool. Use `validate` if you take over schema management.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
